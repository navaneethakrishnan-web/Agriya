# ---------------------------------------------------------
# AGRIYA environment variables
# Copy this file to .env and fill in real values.
# Vite only exposes variables prefixed with VITE_ to the client.
# ---------------------------------------------------------

# Firebase (Project settings > General > Your apps > SDK config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Groq API (https://console.groq.com/keys)
# IMPORTANT: for production, do NOT call Groq directly from the browser with
# this key. Proxy the call through a Firebase Cloud Function (see
# functions/src/askAi.ts) so the key never ships to the client bundle.
VITE_GROQ_API_KEY=GROQ_API_KEY
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# Optional: OpenWeather (only needed if you swap out the default,
# key-free Open-Meteo provider in src/services/weather.ts)
VITE_OPENWEATHER_API_KEY=
